# Copy to backend/.env (or run node scripts/setup-env.mjs at the repository root).
# ./dev loads this file automatically for local development.
# Use an existing local PostgreSQL role and its password.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/weddingly
DATABASE_USERNAME=weddingly
DATABASE_PASSWORD=
# For Neon, select Java in the Connect dialog and turn connection pooling off.
# Supply its username/password separately in DATABASE_USERNAME/DATABASE_PASSWORD.
# DATABASE_URL='jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require&channelBinding=require'
# Quote shell values that contain spaces, &, $, or other special characters.
PORT=8080
# Used only by the dev profile; comma-separated exact origins, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
